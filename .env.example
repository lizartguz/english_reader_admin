# ==========================================================
# English Reader Admin - variables de entorno
# ==========================================================
#
# DESARROLLO LOCAL (`npm run dev`): copiar este archivo como `.env.development`.
# Vite congela estos valores dentro del build.
#
# STAGING / PRODUCCIÓN (contenedor): estas variables NO se usan. La imagen se
# construye sin configuración y el contenedor la recibe al arrancar como
# `API_BASE_URL` y `APP_ENV` (ver `docker-compose.yml`). Así una misma imagen
# sirve para cualquier ambiente sin recompilarse.

# URL base de english_reader_api, tal como la alcanza el navegador del usuario.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# development | staging | production
VITE_APP_ENV=development
