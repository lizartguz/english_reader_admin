server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # No se anuncia la versión del servidor.
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Cabeceras de seguridad. El panel no debe poder incrustarse en otro sitio.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Content-Security-Policy: limita el daño si alguna vez se cuela una
    # inyección, propia o a través de una dependencia. Notas de cada directiva:
    #
    # - script-src 'self': el build de Vite no deja scripts en línea; todo el
    #   JavaScript sale de /assets/ y de /config.js, ambos del mismo origen.
    # - style-src incluye 'unsafe-inline' porque Base UI y sonner insertan
    #   estilos en línea al montarse; sin eso la interfaz se rompe.
    # - img-src incluye blob: para las vistas previas de portadas, que se
    #   descargan autenticadas y se muestran como URL de objeto.
    # - font-src 'self': las tipografías vienen empaquetadas, no de un CDN.
    # - connect-src se completa al arrancar el contenedor con el origen real de
    #   la API (docker/15-csp-origin.envsh), porque cambia según el ambiente.
    # - frame-ancestors 'none' duplica X-Frame-Options para navegadores que ya
    #   solo atienden la CSP.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ${API_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # Los assets llevan hash en el nombre, así que se pueden cachear sin límite.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # La configuración de ambiente cambia entre despliegues de la misma imagen:
    # nunca debe quedar cacheada.
    location = /config.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        expires -1;
        try_files $uri =404;
    }

    # El index tampoco se cachea: es quien apunta a los assets nuevos.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        expires -1;
    }

    # SPA: cualquier ruta desconocida la resuelve React Router, no nginx.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
